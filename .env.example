# 이 파일을 .env.local 로 복사한 뒤 값을 채워 주세요. (.env.local 은 Git에 올라가지 않습니다)

# Supabase 프로젝트 설정 > API 에서 확인 (publishable 키 또는 기존 anon 키)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NEIS 교육정보 개방 포털(open.neis.go.kr) 인증키
# 서버 전용: 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
# 비워 두면 샘플 모드(요청당 5건)로 동작합니다.
NEIS_API_KEY=
